  115     | IDENT
  116     | STRATOM
  117     | VAR
  118     | VAR '[' aidx_expr ']'

  119 slot_acc: expr '.' IDENT
  120         | expr '.' IDENT '[' aidx_expr ']'

  121 intslot_acc: expr opINTNAME class_name_expr
  122            | expr opINTNAMER class_name_expr

  123 class_name_expr: IDENT
  124                | '(' expr ')'

  125 assign_op_struct: opPLUSPLUS
  126                 | opMINUSMINUS
  127                 | opPLASN expr
  128                 | opMIASN expr
  129                 | opMLASN expr
  130                 | opDVASN expr
