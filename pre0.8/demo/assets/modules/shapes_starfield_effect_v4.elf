// -----------------------------------------------------------------------------
// using PointStorageObject (since ElfScript 0.4) << this rocks!
// RelWithDebInfo > 500FPS (from 360 shapes_starfield_effect.elf)
// Debug ~200FPS
// -----------------------------------------------------------------------------

// orig 420
#define STAR_COUNT 420

function createshapes_starfield_effect_v4() {
    %obj = new ScriptGroup() {
        class = "shapes_starfield_effect";
        // TypeF32 speed = 10.0/9.0;
        TypeColor bgColor = 0;

        TypeBool drawLines = true;
    };
    return %obj;
}
// -----------------------------------------------------------------------------
function shapes_starfield_effect::onRemove(%this) {
  SetTargetFPS(60);
}
// -----------------------------------------------------------------------------
function shapes_starfield_effect::UpdateSize(%this) {
    $screenHeight = GetScreenHeight();
    $screenWidth = GetScreenWidth();

    // save as min/max
    $minH = -$screenWidth / 2;
    $maxH = $screenWidth / 2;
    $minW = -$screenHeight / 2;
    $maxW = $screenHeight / 2;

    $hW = $screenWidth  * 0.5;
    $hH = $screenHeight  * 0.5;
}
// -----------------------------------------------------------------------------
function shapes_starfield_effect::OnAdd(%this) {
    // SetWindowSize(800,450);
    %this.bgColor = ColorLerp( DARKBLUE, BLACK, 0.69);
    %this.updateSize();

    %this.add( new PointStorageObject(starPoints) { storageSize = STAR_COUNT; } );

    for ( %i = 0; %i < STAR_COUNT; %i++)
    {
        starPoints.setPoint(%i, GetRandomValue($minH , $maxH),GetRandomValue($minW , $maxW), 1.0 );
    }

    $speed = 10.0/9.0;


    SetTargetFPS(0);

    return true;
}

// -----------------------------------------------------------------------------
function shapes_starfield_effect::Render(%this) {

    %mouseMove = GetMouseWheelMove();

    if (%mouseMove != 0) $speed += %mouseMove / 10.0;
    $speed = mClampF($speed, 0.05, 5.0);


    // Toggle lines / points with space bar
    if (IsKeyPressed(KEY_SPACE)) {
        %this.drawLines = !%this.drawLines;
        echo("SPACE pressed new drawlines is: " SPC %this.drawLines );
    }
    if (IsKeyPressed(KEY_U)) {
        SetTargetFPS(0);
    }
    if (IsKeyPressed(KEY_R)) {
        SetTargetFPS(60);
    }

    if (IsWindowResized()) {
        %this.updateSize();
    }

     %dt = GetFrameTime();


    ClearBackground( %this.bgColor);

    %startDiv = 1.0 / 32.0;
    %drawLines = %this.drawLines;

    %localStarPoints = starPoints.getId();

    for ( %i = 0; %i < STAR_COUNT; %i++)
    {
        %localStarPoints.fetchPoint(%i); // This writes from the point storage to .x,.y,.z

        // >>>>>>>>>>>>>>>> update point
         %localStarPoints.z -= %dt * $speed;

        // Calculate the screen position
        %invZ = 1.0 /  %localStarPoints.z;
        %screenPos_X = $hW + (%localStarPoints.x * %invZ);
        %screenPos_Y = $hH + (%localStarPoints.y * %invZ);

        if ( %localStarPoints.z < 0.0 || %screenPos_X < 0.0 || %screenPos_Y < 0.0
             || %screenPos_X > $screenWidth || %screenPos_Y > $screenHeight)
        {

            %localStarPoints.setPos(GetRandomValue($minH, $maxH), GetRandomValue($minH, $maxH), 1.0);
            %screenPos_X = $hW +  %localStarPoints.x;
            %screenPos_Y = $hH +  %localStarPoints.y;
        }
        // <<<<<<<<<<<<<<<<<<<<<
        if (%drawLines)
        {
            %t = mClampF(%localStarPoints.z + %startDiv , 0.0 , 1.0 );

            if ( (%t - %localStarPoints.z) > 1e-3)
            {
                %invT = 1.0 / %t;
                %startX = $hW + ( %localStarPoints.x * %invT);
                %startY = $hH + (  %localStarPoints.y * %invT);

                DrawLine(%startX, %startY, %screenPos_X, %screenPos_Y, RAYWHITE);
            }
        }
        else
        {
            %radius = mLerp(3.0, 1.0, %localStarPoints.z);
            DrawCircle(%screenPos_X, %screenPos_Y, %radius, RAYWHITE);
        }

        %localStarPoints.storePoint(%i); //this update the point storage from .x,.y,.z
    }


    DrawText("[MOUSE WHEEL] Current Speed:" SPC  strFormat("%.2f",$speed) , 10, 40, 20, RAYWHITE);
    DrawText("[SPACE] Current draw mode:" SPC  ( %this.drawLines ? "Lines" : "Circles" ) , 10, 70, 20, RAYWHITE);

    DrawFPS(10, 10);
}
