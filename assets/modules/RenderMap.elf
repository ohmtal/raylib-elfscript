/*
 * RenderTexture2D target = LoadRenderTexture(screenWidth, screenHeight);
 *  BeginTextureMode(target);
 *  EndTextureMode();
 *   DrawTextureRec(target.texture, (Rectangle){ 0, 0, (float)target.texture.width, (float)-target.texture.height }, (Vector2){ 0, 0 }, WHITE);
 *
 *  TODO: Update to ElfScript 0.7 when released - we not longer use strings for data.
*/
#define _BATCH_COUNT_ 10000
#define _RECT_SIZE_ 50.0
#define _UPDATE_INTERVAL_ 2.0

function createRenderMap() {
    %obj = new SimGroup() {
        class = "RenderMap";
    };

    return %obj;
}
//----------------------------------------------------------------------
function RenderMap::onAdd(%this) {


    %this.updateTimer = _UPDATE_INTERVAL_;

    %this.target = new RenderTextureObject() { width = GetScreenWidth(); height = GetScreenHeight(); };

    %this.add(%this.target); //auto remove (SimGroup)

    echo(" ---------- init done");
    return true;
}
//----------------------------------------------------------------------
function RenderMap::OnRemove(%this) {
}
//----------------------------------------------------------------------
function RenderMap::Render(%this) {

    %this.updateTimer += GetFrameTime();

    if ( %this.updateTimer > _UPDATE_INTERVAL_ ) {
        %h = GetScreenHeight() - _RECT_SIZE_;
        %w = GetScreenWidth() - _RECT_SIZE_;
        %size = _RECT_SIZE_ SPC _RECT_SIZE_;
        %this.updateTimer -= _UPDATE_INTERVAL_;

        %this.target.BeginTextureMode();
        ClearBackground(WHITE);

        for (%i in range _BATCH_COUNT_)
        {

            %color = GetRandomValues(3,0,255) SPC 255;
            %pos = GetRandomValue(0, %w) SPC GetRandomValue(0, %h);
            DrawRectangleV(%pos, %size, %color);
        }
        %this.target.EndTextureMode();
    }
    ClearBackground(WHITE);
    DrawTextureRec(%this.target.texture
    , "0 0" SPC %this.target.width SPC - %this.target.height
    , "0 0"
    , WHITE );

    DrawText("RenderMap example. Rects: _BATCH_COUNT_ Timer is:" SPC strFormat("%d",%this.updateTimer) SPC "/" SPC _UPDATE_INTERVAL_, 5, 5, 20, YELLOW, true, BLACK);

    if (IsWindowResized()) {
       %this.target.resize( GetScreenWidth(),GetScreenHeight());
    }

}

