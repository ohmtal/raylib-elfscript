  136                 | opSRASN expr

  137 stmt_expr: funcall_expr
  138          | assert_expr
  139          | object_decl
  140          | VAR '=' expr
  141          | VAR '=' '{' expr_list '}'
  142          | VAR '[' aidx_expr ']' '=' expr
  143          | VAR '[' aidx_expr ']' '=' '{' expr_list '}'
  144          | VAR assign_op_struct
  145          | VAR '[' aidx_expr ']' assign_op_struct
  146          | slot_acc assign_op_struct
  147          | slot_acc '=' expr
  148          | slot_acc '=' '{' expr_list '}'

  149 funcall_expr: IDENT '(' func_arg_list_decl ')'
  150             | IDENT opCOLONCOLON IDENT '(' func_arg_list_decl ')'
  151             | expr '.' IDENT '(' func_arg_list_decl ')'

  152 func_arg_item: expr
  153              | '{' expr_list '}'

  154 func_arg_list: func_arg_item
  155              | func_arg_list ',' func_arg_item

  156 func_arg_list_decl: ε
  157                   | func_arg_list

  158 assert_expr: rwASSERT '(' expr ')'
  159            | rwASSERT '(' expr ',' STRATOM ')'

  160 expr_list: expr
  161          | expr_list ',' expr

  162 slot_assign_list_opt: ε
  163                     | slot_assign_list

  164 slot_assign_list: slot_assign
  165                 | slot_assign_list slot_assign

  166 slot_assign: IDENT '=' expr ';'
  167            | IDENT '=' '{' expr_list '}' ';'
  168            | TYPEIDENT IDENT '=' expr ';'
  169            | TYPEIDENT IDENT '=' '{' expr_list '}' ';'
  170            | rwDATABLOCK '=' expr ';'
  171            | IDENT '[' aidx_expr ']' '=' expr ';'
  172            | IDENT '[' aidx_expr ']' '=' '{' expr_list '}' ';'
  173            | TYPEIDENT IDENT '[' aidx_expr ']' '=' expr ';'

  174 aidx_expr: expr
