/*
 * Render to Render Target Example
 *
 *
 * RenderTexture2D target = LoadRenderTexture(screenWidth, screenHeight);
 *  BeginTextureMode(target);
 *  EndTextureMode();
 *   DrawTextureRec(target.texture, (Rectangle){ 0, 0, (float)target.texture.width, (float)-target.texture.height }, (Vector2){ 0, 0 }, WHITE);
 *
*/

function createRenderMap() {
    %obj = new Group() {
        class = "RenderMap";
        TypeS32 batchCount = 10000;
        TypeF32 updateInterval  = 1.2; //2.0;
        TypeF32 rectSize = 20.0;

        TypeF32 updateTimer = 0.0;
        TypeS32 target = 0;
    };

    return %obj;
}
//----------------------------------------------------------------------
function RenderMap::onAdd(%this) {


    %this.updateTimer = %this.updateInterval;

    %this.add (
        %this.target = new RenderTextureObject()
        {
            width = GetScreenWidth(); height = GetScreenHeight();

        });


    print(" ---------- init done");
    return true;
}
//----------------------------------------------------------------------
function RenderMap::OnRemove(%this) {
}
//----------------------------------------------------------------------
function RenderMap::Render(%this) {

    %this.updateTimer += GetFrameTime();

    if ( %this.updateTimer > %this.updateInterval ) {
        %h = GetScreenHeight() - %this.rectSize;
        %w = GetScreenWidth() - %this.rectSize;
        %size = %this.rectSize SPC %this.rectSize;
        %this.updateTimer -= %this.updateInterval;

        %this.target.BeginTextureMode();
        ClearBackground(WHITE);

        for (%i in range %this.batchCount)
        {
            %color = { math.randomf(255), math.randomf(255), math.randomf(255), 255};
            %pos = { math.randomf(%w) , math.randomf(%h) };
            DrawRectangleV(%pos, %size, %color);
        }
        %this.target.EndTextureMode();
    }
    ClearBackground(WHITE);
    DrawTextureRec(%this.target.texture
    ,{  0, 0, %this.target.width, -%this.target.height }
    , { 0, 0 }
    , WHITE );

    DrawText(sprintf("Render-Target example. Rects: %d, Timer (%.2f) is: %0.2f"
                ,%this.batchCount, %this.updateInterval, %this.updateTimer)
                , 5, 5, 20, YELLOW, true, BLACK);

    if (IsWindowResized()) {
       %this.target.resize( GetScreenWidth(),GetScreenHeight());
    }

}

